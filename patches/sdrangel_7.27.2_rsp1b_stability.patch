+
+        if (err != sdrplay_api_Success) {
+            qWarning() << "SDRPlayV3Thread::eventCallback: overload ACK failed:" << sdrplay_api_GetErrorString(err);
+        } else if (params) {
+            qDebug() << "SDRPlayV3Thread::eventCallback: power overload event acknowledged:"
+                     << params->powerOverloadParams.powerOverloadChangeType;
+        }
+        break;
+    }
+    case sdrplay_api_DeviceRemoved:
+        qCritical() << "SDRPlayV3Thread::eventCallback: SDRplay device removed";
+        break;
+    case sdrplay_api_DeviceFailure:
+        qCritical() << "SDRPlayV3Thread::eventCallback: SDRplay device failure";
+        break;
+    default:
+        break;
+    }
