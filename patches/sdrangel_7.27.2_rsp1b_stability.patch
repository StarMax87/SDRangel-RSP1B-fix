+void SDRPlayV3Thread::processIQBuffer()
+{
+    if (m_iqCount < 2) {
+        return;
+    }
+
+    // Decimators require a power-of-two number of interleaved values.
+    const int iqLen = lowerPowerOfTwo(m_iqCount);
+    if (iqLen < 2) {
+        return;
